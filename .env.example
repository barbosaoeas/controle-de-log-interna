# ========================================
# CONFIGURAÇÕES DE AMBIENTE
# ========================================
# Copie este arquivo para .env e ajuste os valores conforme necessário

# ========================================
# AMBIENTE
# ========================================
# Valores: development, production
DJANGO_ENV=development

# ========================================
# DEBUG
# ========================================
# True para desenvolvimento, False para produção
DEBUG=True

# ========================================
# SECRET KEY
# ========================================
# Em produção, use uma chave secreta forte e única
# Gere uma nova em: https://djecrety.ir/
SECRET_KEY=django-insecure-z^&&rb(!4xzo!-gf@tu+#!&xtqj52_f-d$271a0zv5+dr7$v&5

# ========================================
# HOSTS PERMITIDOS
# ========================================
# Separe múltiplos hosts por vírgula
# Desenvolvimento:
ALLOWED_HOSTS=localhost,127.0.0.1

# Produção (descomente e ajuste):
# ALLOWED_HOSTS=easmanutencao.pythonanywhere.com,www.seudominio.com

# ========================================
# BANCO DE DADOS
# ========================================
# Deixe vazio para usar SQLite (desenvolvimento)
# Para PostgreSQL em produção, use:
# DATABASE_URL=postgres://usuario:senha@host:porta/nome_banco

# ========================================
# EMAIL
# ========================================
# Configurações de email (apenas para produção)
EMAIL_HOST_USER=sistema.estaleiro@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_aqui

# ========================================
# NOTAS
# ========================================
# - Nunca commite o arquivo .env no Git
# - O arquivo .env é ignorado pelo .gitignore
# - Em produção, configure as variáveis no painel do servidor

